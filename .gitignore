# Python environments and generated bytecode
.venv/
venv/
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Local environment settings and secrets
.env
.env.*
!.env.example
dashboard/.env.local

# Node/Vite build artifacts
dashboard/node_modules/
dashboard/dist/
npm-debug.log*

# Local scratch files and OS/editor state
tmp/
.DS_Store
.vscode/

# Keep raw, archived, and large modelling data local
/dataset/data/
/dataset/data.z01
/dataset/data.z02
/dataset/processed/*

# The public read-only API needs only these compact precomputed artifacts.
!/dataset/processed/risk_results.csv
!/dataset/processed/customer_explanations.csv
!/dataset/processed/evaluation_metrics.json
!/dataset/processed/calibration_assessment.json
!/dataset/processed/shap_global_importance.csv

# Models and full feature/evaluation artifacts are not used by the deployed API.
/models/
